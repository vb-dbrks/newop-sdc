# Copy to .env for local dev. Never commit a real .env.

# --- Database (Lakebase Postgres) ---
# Local dev fallback uses SQLite at sqlite+aiosqlite:///./local.db
DATABASE_URL=sqlite+aiosqlite:///./local.db

# --- Databricks SDK ---
# When run inside a Databricks App these are auto-injected. Set for local dev only.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Volume root for uploads ---
VOLUME_ROOT=/Volumes/main/velocia/uploads

# --- Agent API ---
# Point to the fake_agent (make fake-agent) or a real serving endpoint.
AGENT_API_BASE=http://localhost:9000
AGENT_API_TOKEN=dev-fake-token

# --- Local dev SSO bypass ---
# REJECTED in production. Enables /api/me without a real Databricks Apps header.
DEV_FAKE_USER_EMAIL=author@example.az
DEV_FAKE_USER_NAME=Test Author

# --- Misc ---
LOG_LEVEL=INFO
ALLOWED_FILE_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
MAX_UPLOAD_BYTES=52428800
